# TraceForge configuration (all optional; sane defaults apply).
TRACEFORGE_SERVICE_NAME=my-service
TRACEFORGE_ENABLED=true

# One of: memory, jsonl, sqlite, postgres (postgres not yet implemented)
TRACEFORGE_STORAGE_BACKEND=memory
# Required when storage_backend is jsonl or sqlite
TRACEFORGE_STORAGE_PATH=./traces.jsonl

TRACEFORGE_BATCH_SIZE=50
TRACEFORGE_FLUSH_INTERVAL=1.0
TRACEFORGE_SAMPLING_RATE=1.0
